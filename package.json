{
  "name": "moneylens-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "MoneyLens: Personal Financial Intelligence Web App for Indian Users",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:ml": "powershell -Command \"cd ml-service; .\\.venv\\Scripts\\activate; uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload\"",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test:ml": "powershell -Command \"cd ml-service; .\\.venv\\Scripts\\activate; pytest -v\"",
    "test:smoke": "node scripts/smoke_test.js",
    "test:e2e": "node scripts/e2e_full_flow.js",
    "test": "npm run test:backend && npm run test:frontend && npm run test:ml",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "lint:backend": "npm --prefix backend run lint",
    "lint:ml": "powershell -Command \"cd ml-service; .\\.venv\\Scripts\\activate; ruff check .\""
  }
}
