# ==============================================================================
# MoneyLens Backend Environment Configuration
# ==============================================================================
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (placeholders only):
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/moneylens?retryWrites=true&w=majority
# For local development without Atlas:
# MONGODB_URI=mongodb://localhost:27017/moneylens

# Security & Authentication
JWT_SECRET=moneylens_dev_jwt_secret_must_be_at_least_32_characters_long
JWT_EXPIRY=7d
COOKIE_NAME=moneylens_token
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ML Service & LLM Provider
ML_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=moneylens_dev_internal_api_key_min_32_chars_long
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

