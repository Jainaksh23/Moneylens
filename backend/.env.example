# ==============================================================================
# MoneyLens Backend Environment Configuration
# ==============================================================================
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/moneylens?retryWrites=true&w=majority
JWT_SECRET=<jwt_secret_min_32_chars>
COOKIE_NAME=moneylens_token
INTERNAL_API_KEY=<internal_api_key_min_32_chars>
ML_SERVICE_URL=http://localhost:8000
GROQ_API_KEY=<your_groq_api_key>
GROQ_MODEL=llama-3.3-70b-versatile
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
