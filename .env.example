# ==============================================================================
# MoneyLens Unified Environment Configuration
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Update the secret values (JWT_SECRET, INTERNAL_API_KEY, GROQ_API_KEY).
# 3. Docker Compose will automatically read this .env file on startup.
#    NEVER commit your real .env file with secrets into version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Deployment Environment & Host Port Mappings
# ------------------------------------------------------------------------------
# Set to 'development' for dev builds or 'production' for strict security checks
NODE_ENV=development

# Host ports mapped by Docker Compose (adjust if you have local port conflicts)
FRONTEND_PORT=5173
BACKEND_PORT=5000
MONGO_EXPRESS_PORT=8081

# ------------------------------------------------------------------------------
# 2. Database Configuration (MongoDB Atlas or Local)
# ------------------------------------------------------------------------------
# MongoDB Atlas connection string (Free M0 Mumbai or custom cluster):
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/moneylens?retryWrites=true&w=majority
# For local Docker MongoDB (run with: docker compose --profile local-db up):
# MONGODB_URI=mongodb://mongo:27017/moneylens
# For standalone local development without Docker:
# MONGODB_URI=mongodb://localhost:27017/moneylens

# Mongo Express Web GUI credentials (only used when running with: --profile dev)
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin_dev_password_change_me

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
# Cryptographically random string for signing JWT tokens (min 32 characters in production)
# Generate with: openssl rand -base64 48
JWT_SECRET=moneylens_dev_jwt_secret_must_be_at_least_32_characters_long

# Name of the httpOnly authentication cookie
COOKIE_NAME=moneylens_token

# Allowed CORS origins for backend (comma-separated, no trailing slashes)
# In Docker, frontend is on port 5173 and proxies /api/ requests same-origin
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 4. ML & RAG Microservice Configuration (FastAPI)
# ------------------------------------------------------------------------------
# Shared internal API key for secure backend-to-ml-service communication
INTERNAL_API_KEY=moneylens_dev_internal_api_key_min_32_chars_long

# Groq API Key for LLM inference (financial advisor chat & smart summaries)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ChromaDB persistence directory (inside the container this maps to a named volume)
CHROMA_PERSIST_DIR=/app/chroma_data

# ------------------------------------------------------------------------------
# 5. Frontend Client Configuration (Vite React)
# ------------------------------------------------------------------------------
# In Docker (with Nginx reverse proxy): uses relative path /api/v1 for same-site cookies
# For standalone Vite dev server running on host: http://localhost:5000/api/v1
VITE_API_BASE_URL=/api/v1
