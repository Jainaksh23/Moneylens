# ==========================================
# MoneyLens Monorepo Environment Variables
# Copy to .env for local development
# NEVER commit real credentials to git!
# ==========================================

# ------------------------------------------
# Backend Service Configuration (Node.js/Express)
# ------------------------------------------
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/moneylens?retryWrites=true&w=majority
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
COOKIE_NAME=moneylens_token
ALLOWED_ORIGINS=http://localhost:5173

# Internal communication between Backend and ML Service
ML_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=your-shared-internal-secret-key-min-32-chars

# ------------------------------------------
# ML & RAG Service Configuration (FastAPI)
# ------------------------------------------
ML_PORT=8000
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
CHROMA_PERSIST_DIR=./chroma_data

# ------------------------------------------
# Frontend Service Configuration (Vite React)
# Note: Only non-secret public variables prefixed with VITE_
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
